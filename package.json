{
  "name": "cloudverse",
  "private": true,
  "version": "0.0.0",
  "description": "CloudVerse: a reusable framework that turns Terraform plan/state JSON into interactive 3D worlds.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "doctor": "node tools/doctor.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tools/tsconfig.json",
    "test": "vitest run",
    "build": "vite build apps/explorer && vite build apps/defense-lab",
    "inspect": "node tools/inspect.ts",
    "golden:update": "node tools/golden-update.ts",
    "scan:secrets": "node tools/secret-scan.ts",
    "fixtures:validate": "node tools/fixtures-validate.ts",
    "fixtures:generate": "node tools/fixtures-generate.ts"
  },
  "devDependencies": {
    "@cloudverse/core": "workspace:*",
    "@cloudverse/provider-aws": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
